{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "execution_canonical_profiles.schema.json",
  "title": "CO-002 Canonical Execution Profile Payloads",
  "definitions": {
    "pack_execution": {
      "type": "object",
      "required": ["task_id", "run_id", "trace_id", "correlation_id", "capability", "input_payload", "expected_evidence"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string"},
        "run_id": {"type": "string"},
        "trace_id": {"type": "string"},
        "correlation_id": {"type": "string", "pattern": "^YARP-CORR-[0-9a-f-]{36}$"},
        "capability": {"type": "string"},
        "input_payload": {"type": "object"},
        "expected_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pack_result": {
      "type": "object",
      "required": ["task_id", "run_id", "trace_id", "correlation_id", "execution_object_id", "outcome", "receipt_id", "output", "error"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string"},
        "run_id": {"type": "string"},
        "trace_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "execution_object_id": {"type": "string"},
        "outcome": {"enum": ["success", "failure"]},
        "receipt_id": {"type": "string"},
        "output": {"type": ["object", "null"]},
        "error": {"type": ["object", "null"]}
      }
    },
    "artifact_evidence": {
      "type": "object",
      "required": ["trace_id", "correlation_id", "result_object_id", "receipt_id", "evidence"],
      "additionalProperties": false,
      "properties": {
        "trace_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "result_object_id": {"type": "string"},
        "receipt_id": {"type": "string"},
        "evidence": {"type": "object"}
      }
    }
  }
}
